# ===========================
# ⚛️ FRONTEND (React / Node)
# ===========================
# Dependencies (Heavy!)
node_modules/
frontend/node_modules/

# Build Outputs (Don't commit compiled code)
frontend/dist/
frontend/build/

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Framework caches
frontend/.next/
frontend/.nuxt/
frontend/.cache/
frontend/.parcel-cache/

# ===========================
# 🔐 SECURITY & SECRETS
# ===========================
# Ignore .env files everywhere to prevent leaks
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*

