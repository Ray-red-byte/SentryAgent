# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it is already in .gitignore.

GEMINI_API_KEY=your-gemini-api-key-here

CHROMA_HOST=chromadb_server
CHROMA_PORT=8000

# Database Config
POSTGRES_USER=sentry_user
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_DB=sentry_db
POSTGRES_SERVER=db

# JWT Auth (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=your-long-random-secret-here

# API login credentials (used by POST /v2/auth/token)
API_USERNAME=admin
API_PASSWORD=your-strong-password-here

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
